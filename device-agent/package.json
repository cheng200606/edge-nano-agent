{
  "name": "device-agent",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun apps/agent-gateway/src/main.ts",
    "dev": "bun run --watch apps/agent-gateway/src/main.ts",
    "typecheck": "tsc -p apps/agent-gateway/tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "bun scripts/build-agent-gateway.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:check": "bun scripts/db-check.ts",
    "config:schema": "bun scripts/gen-config-schema.ts",
    "mqtt:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mqtt-broker.ps1 start",
    "mqtt:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mqtt-broker.ps1 stop",
    "mqtt:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/mqtt-broker.ps1 status",
    "e2e:m3": "bun scripts/m3-e2e.ts",
    "verify:m4": "bun scripts/m4-verify.ts",
    "demo": "bun scripts/demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@device-agent/iot-platform": "workspace:*",
    "@device-agent/persistence": "workspace:*",
    "@device-agent/prompts": "workspace:*",
    "@device-agent/shared": "workspace:*",
    "@device-agent/skitter": "workspace:*",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.7.0",
    "@sinclair/typebox": "^0.34.52",
    "commander": "^15.1.0",
    "drizzle-orm": "^0.45.4",
    "mqtt": "^5.16.1",
    "zod": "^4.6.7"
  }
}
