# docker/Dockerfile.base —— 全部服务共用的基础镜像（edgeguard-base:latest）
#
# 2026-11-21 变更：原 SRS 附录 B 基于 miniob-course 底座（2.89 GB），当前 daemon 中该镜像已被清理，
# 且 Docker Hub 拉取通道已恢复。改用官方 python:3.12-slim（约 160 MB）重建：
#   - Python 3.12 + pip 官方镜像自带，无 PEP 668（EXTERNALLY-MANAGED）限制
#   - iproute2 提供 tc/ip，供 I5 迭代容器内弱网注入（NET_ADMIN 由 compose 授予）
#   - pip 走阿里云镜像（保持确定性，不依赖 PyPI 官网连通性）
FROM python:3.12-slim

ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai

RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources; \
    fi \
    && if [ -f /etc/apt/sources.list ]; then \
        sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends iproute2 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir numpy paho-mqtt amqtt \
    && rm -rf /root/.cache/pip
