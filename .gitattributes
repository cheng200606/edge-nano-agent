# 仓库内所有文本统一为 LF，检出时不转换为 CRLF（容器内 bash 对 CRLF 敏感）
* text=auto eol=lf

# Windows 原生脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件禁止任何行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.gz binary
*.zip binary
*.whl binary
